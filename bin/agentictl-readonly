#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
AGENTICTL_SCRIPT_DIR="$SCRIPT_DIR"
CORE_FILE="${AGENTICTL_CORE_FILE:-$SCRIPT_DIR/../lib/agentictl/core.sh}"

if [[ ! -r "$CORE_FILE" ]]; then
  printf '{"ok":false,"error":"agentictl core not found"}\n'
  exit 70
fi

# shellcheck source=../lib/agentictl/core.sh
source "$CORE_FILE"

cmd="${1:-}"; shift || true
agentictl_load_modules

case "$cmd" in
  capabilities)
    agentictl_print_capabilities readonly
    ;;
  "")
    fail 64 "usage: agentictl-readonly <verb>"
    ;;
  *)
    agentictl_dispatch_module readonly "$cmd" "$@"
    ;;
esac

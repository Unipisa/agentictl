#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
AGENTICTL_SCRIPT_DIR="$SCRIPT_DIR"
CORE_FILE="${AGENTICTL_CORE_FILE:-$SCRIPT_DIR/../lib/agentictl/core.sh}"

if [[ ! -r "$CORE_FILE" ]]; then
  printf '{"ok":false,"error":"agentictl core not found"}\n'
  exit 70
fi

# shellcheck source=../lib/agentictl/core.sh
source "$CORE_FILE"

usage() {
  cat <<'USAGE'
{"ok":false,"error":"usage: agentictl {readonly|act} <command tokens>; over SSH, pass the command as SSH_ORIGINAL_COMMAND"}
USAGE
}

mode="${1:-readonly}"
if [[ "$mode" == "readonly" || "$mode" == "act" ]]; then
  shift || true
else
  fail 64 "invalid mode: $mode"
fi

if [[ $# -gt 0 ]]; then
  argv=("$@")
else
  original="${SSH_ORIGINAL_COMMAND:-}"
  [[ -n "$original" ]] || { usage; exit 64; }
  [[ "${#original}" -le "$MAX_ORIGINAL_COMMAND_BYTES" ]] || fail 65 "SSH_ORIGINAL_COMMAND too long"
  [[ "$original" != *$'\n'* && "$original" != *$'\r'* ]] || fail 65 "newlines are not allowed"
  IFS=' ' read -r -a argv <<< "$original"
fi

[[ "${#argv[@]}" -gt 0 ]] || fail 64 "missing command"

for token in "${argv[@]}"; do
  [[ -n "$token" ]] || fail 65 "empty token is not allowed"
  [[ "$token" =~ $TOKEN_REGEX ]] || fail 65 "unsafe token: $token"
  [[ "$token" != *".."* ]] || fail 65 "parent-directory references are not allowed"
done

command_name="${argv[0]}"
agentictl_load_modules

if agentictl_mode_has_verb "$mode" "$command_name"; then
  audit_event "allow" "$mode:$command_name" "dispatch"
  exec "$SCRIPT_DIR/agentictl-$mode" "${argv[@]}"
fi

audit_event "deny" "$mode:$command_name" "64"
fail 64 "command not allowed in $mode mode: $command_name"

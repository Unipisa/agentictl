#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

BASE_DIR="${AGENTICTL_BASE_DIR:-${OPENCLAW_BASE_DIR:-/opt/agentictl}}"
POLICY_FILE="${AGENTICTL_POLICY_FILE:-${OPENCLAW_POLICY_FILE:-$BASE_DIR/config/policy.env}}"
AUDIT_LOG="${AGENTICTL_AUDIT_LOG:-${OPENCLAW_AUDIT_LOG:-$BASE_DIR/state/audit.log}}"
BACKUP_DIR="${AGENTICTL_BACKUP_DIR:-${OPENCLAW_BACKUP_DIR:-$BASE_DIR/state/backups}}"
STAGING_DIR="${AGENTICTL_STAGING_DIR:-${OPENCLAW_STAGING_DIR:-$BASE_DIR/state/incoming}}"
MAX_CONFIG_BYTES="${AGENTICTL_MAX_CONFIG_BYTES:-${OPENCLAW_MAX_CONFIG_BYTES:-1048576}}"

ALLOWED_UNITS_REGEX='^[a-zA-Z0-9_.@-]+\.service$'
ALLOWED_PACKAGES_REGEX='^[a-zA-Z0-9_.+:-]+$'
SAFE_STAGE_NAME_REGEX='^[a-zA-Z0-9_.@-]+$'

json_string() {
  local value="${1-}"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

fail() { local code="$1"; shift; printf '{"ok":false,"error":%s}\n' "$(json_string "$*")"; exit "$code"; }
need_cmd() { command -v "$1" >/dev/null 2>&1 || fail 70 "missing command: $1"; }

maybe_reexec_with_sudo() {
  [[ "${AGENTICTL_ACT_SUDO:-${OPENCLAW_ACT_SUDO:-auto}}" != "never" ]] || return 0
  [[ "${EUID:-$(id -u)}" -ne 0 ]] || return 0

  local arg wants_execute="false"
  for arg in "$@"; do
    [[ "$arg" == "--execute" ]] && wants_execute="true"
  done

  [[ "$wants_execute" == "true" ]] || return 0
  command -v sudo >/dev/null 2>&1 || fail 70 "sudo is required for --execute"
  exec sudo -n -- "$0" "$@"
}

load_policy() {
  [[ -r "$POLICY_FILE" ]] || fail 66 "missing policy file: $POLICY_FILE"
  # shellcheck source=/dev/null
  source "$POLICY_FILE"
  : "${ALLOW_SERVICE_RESTART:=}"
  : "${ALLOW_PACKAGE_INSTALL:=}"
  : "${ALLOW_CONFIG_TARGETS:=}"
  : "${AGENTICTL_MAX_CONFIG_BYTES:=${OPENCLAW_MAX_CONFIG_BYTES:-1048576}}"
  MAX_CONFIG_BYTES="$AGENTICTL_MAX_CONFIG_BYTES"
}

contains_word() {
  local needle="$1"; shift
  local haystack=" $* "
  [[ "$haystack" == *" $needle "* ]]
}

audit() {
  local action="$1" target="$2" mode="$3" result="$4"
  printf '{"ts":%s,"actor":%s,"action":%s,"target":%s,"mode":%s,"result":%s}\n' \
    "$(json_string "$(date --iso-8601=seconds 2>/dev/null || date)")" \
    "$(json_string "${USER:-unknown}")" \
    "$(json_string "$action")" \
    "$(json_string "$target")" \
    "$(json_string "$mode")" \
    "$(json_string "$result")" >> "$AUDIT_LOG"
}

require_execute_flag() {
  [[ "${EXECUTE:-false}" == "true" ]] || fail 67 "refusing to act without --execute; use --dry-run to preview"
}

require_staged_source() {
  local source_file="$1"
  local source_real staging_real
  need_cmd readlink
  source_real="$(readlink -f "$source_file")" || fail 66 "source file not readable"
  staging_real="$(readlink -f "$STAGING_DIR")" || fail 66 "staging directory not readable"
  [[ "$source_real" == "$staging_real"/* ]] || fail 77 "source must be under staging directory: $STAGING_DIR"
}

install_staged_file() {
  local tmp="$1" target="$2"
  local owner="${SUDO_USER:-${USER:-}}"
  if [[ -n "$owner" ]] && id "$owner" >/dev/null 2>&1; then
    install -m 0640 -o "$owner" -g "$(id -gn "$owner")" "$tmp" "$target"
  else
    install -m 0640 "$tmp" "$target"
  fi
}

cmd="${1:-}"; shift || true
maybe_reexec_with_sudo "$cmd" "$@"
mkdir -p "$(dirname "$AUDIT_LOG")" "$BACKUP_DIR" "$STAGING_DIR"
load_policy

case "$cmd" in
  capabilities)
    printf '{"ok":true,"mode":"act","commands":["service-restart","package-install","config-stage","config-apply","capabilities"],"allow_service_restart":%s,"allow_package_install":%s,"allow_config_targets":%s,"staging_dir":%s}\n' \
      "$(json_string "$ALLOW_SERVICE_RESTART")" \
      "$(json_string "$ALLOW_PACKAGE_INSTALL")" \
      "$(json_string "$ALLOW_CONFIG_TARGETS")" \
      "$(json_string "$STAGING_DIR")"
    ;;

  service-restart)
    unit=""; EXECUTE="false"; DRY_RUN="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --unit) unit="${2:-}"; shift 2 ;;
        --dry-run) DRY_RUN="true"; shift ;;
        --execute) EXECUTE="true"; shift ;;
        *) fail 64 "unknown argument: $1" ;;
      esac
    done
    [[ "$unit" =~ $ALLOWED_UNITS_REGEX ]] || fail 65 "invalid unit"
    contains_word "$unit" "$ALLOW_SERVICE_RESTART" || fail 77 "unit not allowed: $unit"
    if [[ "$DRY_RUN" == "true" ]]; then
      printf '{"ok":true,"dry_run":true,"action":"service-restart","unit":"%s"}\n' "$unit"
      exit 0
    fi
    require_execute_flag
    need_cmd systemctl
    systemctl restart "$unit"
    systemctl is-active --quiet "$unit" && result="active" || result="not-active"
    audit "service-restart" "$unit" "execute" "$result"
    printf '{"ok":true,"action":"service-restart","unit":"%s","result":"%s"}\n' "$unit" "$result"
    ;;

  package-install)
    pkg=""; EXECUTE="false"; DRY_RUN="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name) pkg="${2:-}"; shift 2 ;;
        --dry-run) DRY_RUN="true"; shift ;;
        --execute) EXECUTE="true"; shift ;;
        *) fail 64 "unknown argument: $1" ;;
      esac
    done
    [[ "$pkg" =~ $ALLOWED_PACKAGES_REGEX ]] || fail 65 "invalid package name"
    contains_word "$pkg" "$ALLOW_PACKAGE_INSTALL" || fail 77 "package not allowed: $pkg"
    if [[ "$DRY_RUN" == "true" ]]; then
      printf '{"ok":true,"dry_run":true,"action":"package-install","package":"%s"}\n' "$pkg"
      exit 0
    fi
    require_execute_flag
    if command -v apt-get >/dev/null 2>&1; then installer=(apt-get install -y --no-install-recommends "$pkg")
    elif command -v dnf >/dev/null 2>&1; then installer=(dnf install -y "$pkg")
    else fail 70 "no supported package manager found"; fi
    "${installer[@]}"
    audit "package-install" "$pkg" "execute" "success"
    printf '{"ok":true,"action":"package-install","package":"%s"}\n' "$pkg"
    ;;

  config-stage)
    name=""; EXECUTE="false"; DRY_RUN="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --name) name="${2:-}"; shift 2 ;;
        --dry-run) DRY_RUN="true"; shift ;;
        --execute) EXECUTE="true"; shift ;;
        *) fail 64 "unknown argument: $1" ;;
      esac
    done
    [[ "$name" =~ $SAFE_STAGE_NAME_REGEX ]] || fail 65 "invalid stage name"
    [[ "$name" != *".."* ]] || fail 65 "parent-directory references are not allowed"
    target="$STAGING_DIR/$name"
    if [[ "$DRY_RUN" == "true" ]]; then
      printf '{"ok":true,"dry_run":true,"action":"config-stage","path":"%s","max_bytes":%s}\n' "$target" "$MAX_CONFIG_BYTES"
      exit 0
    fi
    require_execute_flag
    tmp="$STAGING_DIR/.$name.tmp.$$"
    dd bs=1 count="$MAX_CONFIG_BYTES" of="$tmp" status=none 2>/dev/null
    bytes="$(wc -c < "$tmp" | tr -d ' ')"
    if IFS= read -r -n 1 extra; then
      rm -f "$tmp"
      fail 65 "stdin exceeds AGENTICTL_MAX_CONFIG_BYTES"
    fi
    install_staged_file "$tmp" "$target"
    rm -f "$tmp"
    audit "config-stage" "$target" "execute" "bytes=$bytes"
    printf '{"ok":true,"action":"config-stage","path":"%s","bytes":%s}\n' "$target" "$bytes"
    ;;

  config-apply)
    target=""; source_file=""; EXECUTE="false"; DRY_RUN="false"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --target) target="${2:-}"; shift 2 ;;
        --source) source_file="${2:-}"; shift 2 ;;
        --dry-run) DRY_RUN="true"; shift ;;
        --execute) EXECUTE="true"; shift ;;
        *) fail 64 "unknown argument: $1" ;;
      esac
    done
    [[ -n "$target" && -n "$source_file" ]] || fail 65 "--target and --source are required"
    [[ -r "$source_file" ]] || fail 66 "source file not readable"
    contains_word "$target" "$ALLOW_CONFIG_TARGETS" || fail 77 "config target not allowed: $target"
    require_staged_source "$source_file"
    if [[ "$DRY_RUN" == "true" ]]; then
      if [[ -e "$target" ]]; then
        diff -u "$target" "$source_file" || true
      else
        printf '{"ok":true,"dry_run":true,"action":"config-apply","target":"%s","source":"%s","target_exists":false}\n' "$target" "$source_file"
      fi
      exit 0
    fi
    require_execute_flag
    if [[ -e "$target" ]]; then
      backup="$BACKUP_DIR/$(basename "$target").$(date +%Y%m%dT%H%M%S).bak"
      cp -a "$target" "$backup"
    else
      backup=""
      install -d -m 0755 "$(dirname "$target")"
    fi
    install -m 0644 "$source_file" "$target"
    audit "config-apply" "$target" "execute" "backup=$backup"
    printf '{"ok":true,"action":"config-apply","target":"%s","backup":"%s"}\n' "$target" "$backup"
    ;;

  *)
    fail 64 "usage: agentictl-act {capabilities|service-restart|package-install|config-stage|config-apply}"
    ;;
esac
